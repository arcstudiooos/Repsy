{
  "name": "repsy",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @repsy/web --filter @repsy/worker dev",
    "lint": "eslint . && pnpm --filter @repsy/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @repsy/web test:e2e",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @repsy/db db:deploy",
    "db:seed": "pnpm --filter @repsy/db db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check --end-of-line auto apps packages .github README.md package.json pnpm-workspace.yaml render.yaml docker-compose.yml",
    "perf:dashboard": "pnpm --filter @repsy/core perf:dashboard"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
