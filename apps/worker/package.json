{
  "name": "@kinetic/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pgboss:migrate": "node --env-file-if-exists=../../.env --import tsx src/pgbossMigrate.ts",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts"
  },
  "dependencies": {
    "@kinetic/core": "workspace:*",
    "@kinetic/db": "workspace:*",
    "@kinetic/storage": "workspace:*",
    "@sentry/node": "11.10.0",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "resend": "6.37.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
