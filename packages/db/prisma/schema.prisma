  @@map("join_links")
}

/// PRD M8: platform-wide incident and maintenance notices (system scope only; CHECK in migration 000062).
model PlatformNotice {
  id         String    @id @default(uuid()) @db.Uuid
  severity   String
  message    String
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  postmortem String?

  creator User @relation("PlatformNoticeCreator", fields: [createdBy], references: [id])

  @@index([createdAt])
  @@map("platform_notices")
}

/// D-011 #5: an uploaded file in private storage (CHECK in migration 000063). Erasure sets erased_at; a worker job
/// deletes the object and then the row.
model MediaFile {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid
  uploadedBy     String    @map("uploaded_by") @db.Uuid
  /// progress_photo, message, form_check or exercise_demo.
  purpose        String
  contentType    String    @map("content_type")
  bytes          Int
  storageKey     String    @unique @map("storage_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  erasedAt       DateTime? @map("erased_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  client         Client?         @relation(fields: [clientId, organizationId], references: [id, organizationId])
  uploader       User            @relation("MediaUploader", fields: [uploadedBy], references: [id])
  progressPhoto  ProgressPhoto?
  sessionMedia   SessionMedia?
  messages       Message[]
  exercises      Exercise[]

  @@unique([id, organizationId])
  @@index([organizationId, clientId])
  @@map("media_files")
}

/// PRD E3: a front, side or back progress photo on a day.
model ProgressPhoto {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  mediaId        String   @unique @map("media_id") @db.Uuid
  pose           String
  takenOn        DateTime @map("taken_on") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  media        MediaFile    @relation(fields: [mediaId, organizationId], references: [id, organizationId])

  @@unique([mediaId, organizationId])
  @@index([organizationId, clientId, takenOn])
  @@map("progress_photos")
}

/// PRD D10: a form-check video on a session (optionally on one exercise of it).
model SessionMedia {
  id                       String   @id @default(uuid()) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  sessionId                String   @map("session_id") @db.Uuid
  workoutVersionExerciseId String?  @map("workout_version_exercise_id") @db.Uuid
  mediaId                  String   @unique @map("media_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session               WorkoutSession          @relation(fields: [sessionId, organizationId], references: [id, organizationId])
  workoutVersionExercise WorkoutVersionExercise? @relation(fields: [workoutVersionExerciseId, organizationId], references: [id, organizationId])
  media                 MediaFile               @relation(fields: [mediaId, organizationId], references: [id, organizationId])

  @@unique([mediaId, organizationId])
  @@index([sessionId])
  @@index([organizationId])
  @@map("session_media")
}

/// PRD H11: one device's browser push subscription (user-level, own rows only).
model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSentAt DateTime? @map("last_sent_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// PRD H11: a push to send; the kind only, never content (D-011 #6).
model OutboxPush {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  toUserId       String    @map("to_user_id") @db.Uuid
  kind           String
  idempotencyKey String    @unique @map("idempotency_key")
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  toUser       User         @relation(fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("outbox_pushes")
}

/// PRD H5: a message the coach wrote to send later, at a client-local time.
model ScheduledMessage {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  threadId       String    @map("thread_id") @db.Uuid
  senderUserId   String    @map("sender_user_id") @db.Uuid
  body           String
  sendAt         DateTime  @map("send_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  messageId      String?   @map("message_id") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// Why it could not be sent (the sender left, the thread closed).
  failure        String?

  organization Organization       @relation(fields: [organizationId], references: [id])
  thread       ConversationThread @relation(fields: [threadId, organizationId], references: [id, organizationId])
  sender       User               @relation(fields: [senderUserId], references: [id])

  @@index([organizationId, threadId])
  @@map("scheduled_messages")
}

/// PRD I4: a day the client opened the portal (their local date); nothing about what they looked at.
model PortalVisit {
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  localDate      DateTime @map("local_date") @db.Date

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([clientId, localDate])
  @@index([organizationId])
  @@map("portal_visits")
}

/// PRD B14: terms or a waiver clients accept in the portal; editing the text makes a new version.
model Agreement {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String
  body           String
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id])
  acceptances  AgreementAcceptance[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("agreements")
}

/// PRD B14: one client's acceptance of one version; insert-only (trigger, migration 000071).
model AgreementAcceptance {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  agreementId    String   @map("agreement_id") @db.Uuid
  version        Int
  clientId       String   @map("client_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  acceptedAt     DateTime @map("accepted_at") @db.Timestamptz(3)
  ip             String?

  organization Organization @relation(fields: [organizationId], references: [id])
  agreement    Agreement    @relation(fields: [agreementId, organizationId], references: [id, organizationId])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([agreementId, version, clientId])
  @@index([organizationId, clientId])
  @@map("agreement_acceptances")
}

/// PRD A10: an emailed invite to join the workspace's team as admin, coach or assistant.
model TeamInvite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  /// admin, coach or assistant.
  role           String
  tokenHash      String    @unique @map("token_hash")
  invitedBy      String    @map("invited_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedBy     String?   @map("accepted_by") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  inviter      User         @relation("TeamInviter", fields: [invitedBy], references: [id])
  invitee      User?        @relation("TeamInvitee", fields: [acceptedBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("team_invites")
}

/// PRD A13: one coach covers another's clients for a date range.
model CoachCover {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  coachUserId    String    @map("coach_user_id") @db.Uuid
  coverUserId    String    @map("cover_user_id") @db.Uuid
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(3)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  coach        User         @relation("CoverAway", fields: [coachUserId], references: [id])
  cover        User         @relation("CoverCovering", fields: [coverUserId], references: [id])
  creator      User         @relation("CoverCreator", fields: [createdBy], references: [id])

  @@index([organizationId, coverUserId])
  @@index([organizationId, coachUserId])
  @@map("coach_covers")
}

/// PRD C17, J5: the next template in a client's queue, started when the running program ends.
model ProgramPhase {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  templateProgramId String    @map("template_program_id") @db.Uuid
  position          Int
  /// auto (starts on its own) or approve (waits for the coach, PRD J7).
  mode              String    @default("auto")
  /// queued, started or cancelled.
  status            String    @default("queued")
  assignmentId      String?   @map("assignment_id") @db.Uuid
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  template     Program      @relation(fields: [templateProgramId, organizationId], references: [id, organizationId])
  creator      User         @relation(fields: [createdBy], references: [id])

  @@index([organizationId, clientId, status])
  @@map("program_phases")
}

/// PRD J2: something that happened to a client, for automations to react to; processed once by the worker.
model ClientEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  kind           String
  detailJson     Json      @default("{}") @map("detail_json")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, clientId])
  @@map("client_events")
}

/// PRD J1: an automation: a trigger and ordered steps.
model Sequence {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  trigger        String
  /// tag id (tag_added) or stage (stage_changed).
  triggerValue   String?   @map("trigger_value")
  active         Boolean   @default(true)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id])
  creator      User           @relation(fields: [createdBy], references: [id])
  steps        SequenceStep[]
  runs         SequenceRun[]

  @@unique([id, organizationId])
  @@index([organizationId, trigger])
  @@map("sequences")
}

/// PRD J1, J3: one step: on day N after the start, at a client-local time.
model SequenceStep {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  sequenceId     String  @map("sequence_id") @db.Uuid
  position       Int
  dayOffset      Int     @map("day_offset")
  localTime      String  @map("local_time")
  type           String
  configJson     Json    @default("{}") @map("config_json")
  /// PRD J7: wait in the review queue for approval.
  askFirst       Boolean @default(false) @map("ask_first")

  organization Organization      @relation(fields: [organizationId], references: [id])
  sequence     Sequence          @relation(fields: [sequenceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  runs         SequenceStepRun[]

  @@unique([id, organizationId])
  @@index([sequenceId])
  @@map("sequence_steps")
}

/// PRD J8: one client going through a sequence.
model SequenceRun {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sequenceId     String    @map("sequence_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  status         String    @default("active")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id])
  sequence     Sequence          @relation(fields: [sequenceId, organizationId], references: [id, organizationId])
  client       Client            @relation(fields: [clientId, organizationId], references: [id, organizationId])
  steps        SequenceStepRun[]

  @@unique([id, organizationId])
  @@index([organizationId, clientId])
  @@map("sequence_runs")
}

/// PRD J8: one step of one run: pending, waiting (for approval), done, failed or skipped.
model SequenceStepRun {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  runId          String    @map("run_id") @db.Uuid
  stepId         String    @map("step_id") @db.Uuid
  dueAt          DateTime  @map("due_at") @db.Timestamptz(3)
  status         String    @default("pending")
  executedAt     DateTime? @map("executed_at") @db.Timestamptz(3)
  error          String?

  organization Organization @relation(fields: [organizationId], references: [id])
  run          SequenceRun  @relation(fields: [runId, organizationId], references: [id, organizationId], onDelete: Cascade)
  step         SequenceStep @relation(fields: [stepId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([runId, stepId])
  @@map("sequence_step_runs")
}
