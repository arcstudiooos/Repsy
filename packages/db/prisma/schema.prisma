generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  coach
  client

  @@map("membership_role")
}

enum MembershipStatus {
  active
  inactive

  @@map("membership_status")
}

enum ClientStatus {
  invited
  active
  paused
  archived

  @@map("client_status")
}

enum Units {
  kg
  lb

  @@map("units")
}

enum TrackingType {
  reps_load
  duration
  distance

  @@map("tracking_type")
}

enum OutboxStatus {
  pending
  sending
  sent
  failed

  @@map("outbox_status")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  image           String?
  emailVerified   Boolean   @default(false) @map("email_verified")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownedOrganizations       Organization[]
  memberships              Membership[]
  createdPilotCodes        PilotCode[]             @relation("PilotCodeCreatedBy")
  usedPilotCodes           PilotCode[]             @relation("PilotCodeUsedBy")
  outboxEmails             OutboxEmail[]
  clientProfiles           Client[]                @relation("ClientUser")
  coachedClients           Client[]                @relation("ClientCoach")
  createdInvites           ClientInvite[]
  createdPrograms          Program[]               @relation("ProgramCreator")
  committedProgramVersions ProgramVersion[]        @relation("ProgramVersionCommitter")
  confirmedAssignments     ProgramAssignment[]     @relation("AssignmentReadinessConfirmer")
  loggedSessions           WorkoutSession[]        @relation("SessionLogger")
  writtenSetLogs           SetLog[]                @relation("SetLogWriter")
  programDrafts            ProgramDraft[]          @relation("ProgramDraftEditor")
  setLogRevisions          SetLogRevision[]        @relation("SetLogReviser")
  clientPauses             ClientPause[]           @relation("ClientPauseCreator")
  coachThreads             ConversationThread[]    @relation("ThreadCoach")
  sentMessages             Message[]               @relation("MessageSender")
  resolvedFlags            ReviewFlag[]            @relation("FlagResolver")
  createdFlags             ReviewFlag[]            @relation("FlagCreator")
  internalNotes            InternalNote[]          @relation("NoteAuthor")
  recordedMetrics          MetricEntry[]           @relation("MetricRecorder")
  metricRevisions          MetricEntryRevision[]   @relation("MetricReviser")
  reviewedCheckins         Checkin[]               @relation("CheckinReviewer")
  createdHabits            Habit[]                 @relation("HabitCreator")
  nutritionTargetsSet      NutritionTarget[]       @relation("NutritionTargetSetter")
  exportJobs               ExportJob[]             @relation("ExportRequester")
  deletionSubjects         DeletionRequest[]       @relation("DeletionSubject")
  deletionRequested        DeletionRequest[]       @relation("DeletionRequester")
  deletionVerified         DeletionRequest[]       @relation("DeletionVerifier")
  supportGrants            SupportAccessGrant[]    @relation("SupportAdmin")
  sessions                 Session[]
  accounts                 Account[]
  coachProfile             CoachProfile?
  notificationPreference   NotificationPreference?

  @@map("users")
}

// Better Auth tables. Not tenant-owned (no organization_id), so no RLS.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model Organization {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  timezone          String
  plan              String   @default("pilot")
  ownerUserId       String   @map("owner_user_id") @db.Uuid
  graceHours        Int      @default(24) @map("grace_hours")
  activeClientLimit Int      @default(30) @map("active_client_limit")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                   User                     @relation(fields: [ownerUserId], references: [id])
  memberships             Membership[]
  auditEvents             AuditEvent[]
  outboxEmails            OutboxEmail[]
  clients                 Client[]
  clientInvites           ClientInvite[]
  exercises               Exercise[]
  programs                Program[]
  programVersions         ProgramVersion[]
  programSlots            ProgramSlot[]
  workoutVersions         WorkoutVersion[]
  workoutVersionExercises WorkoutVersionExercise[]
  programAssignments      ProgramAssignment[]
  workoutSessions         WorkoutSession[]
  setLogs                 SetLog[]
  programDrafts           ProgramDraft[]
  setLogRevisions         SetLogRevision[]
  clientPauses            ClientPause[]
  checkinTemplates        CheckinTemplate[]
  checkins                Checkin[]
  conversationThreads     ConversationThread[]
  messages                Message[]
  reviewFlags             ReviewFlag[]
  internalNotes           InternalNote[]
  exportJobs              ExportJob[]
  deletionRequests        DeletionRequest[]
  supportAccessGrants     SupportAccessGrant[]
  metricEntries           MetricEntry[]
  metricEntryRevisions    MetricEntryRevision[]
  habits                  Habit[]
  habitLogs               HabitLog[]
  clientTags              ClientTag[]
  clientTagLinks          ClientTagLink[]
  nutritionTargets        NutritionTarget[]
  nutritionLogs           NutritionLog[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(active)
  /// When this coach last marked the review list as seen (Sprint 2 "new completed workouts"). Null = never.
  reviewSeenAt   DateTime?        @map("review_seen_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId, role])
  @@index([organizationId])
  @@map("memberships")
}

model PilotCode {
  id        String    @id @default(uuid()) @db.Uuid
  codeHash  String    @unique @map("code_hash")
  createdBy String    @map("created_by") @db.Uuid
  usedBy    String?   @map("used_by") @db.Uuid
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  creator User  @relation("PilotCodeCreatedBy", fields: [createdBy], references: [id])
  user    User? @relation("PilotCodeUsedBy", fields: [usedBy], references: [id])

  @@map("pilot_codes")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  action         String
  metadataJson   Json     @default("{}") @map("metadata_json")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_events")
}

model OutboxEmail {
  id             String       @id @default(uuid()) @db.Uuid
  /// Null for platform emails (verification, password reset); visible only under bypass.
  organizationId String?      @map("organization_id") @db.Uuid
  kind           String
  /// Exactly one of toUserId / toEmail is set (CHECK). toEmail addresses people without an account yet (client invites).
  toUserId       String?      @map("to_user_id") @db.Uuid
  toEmail        String?      @map("to_email")
  templateKey    String       @map("template_key")
  payloadJson    Json         @map("payload_json")
  idempotencyKey String       @unique @map("idempotency_key")
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseUntil     DateTime?    @map("lease_until") @db.Timestamptz(3)
  sentAt         DateTime?    @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id])
  toUser       User?         @relation(fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([status])
  @@index([status, nextAttemptAt])
  @@map("outbox_emails")
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  coachUserId    String       @map("coach_user_id") @db.Uuid
  name           String
  /// Stored lowercased.
  email          String
  status         ClientStatus @default(invited)
  startDate      DateTime?    @map("start_date") @db.Date
  goals          String?
  /// Client context card (PRD B7), coaches only: why they came, schedule limits, equipment, preferences.
  motivation     String?
  scheduleNotes  String?      @map("schedule_notes")
  equipmentNotes String?      @map("equipment_notes")
  preferences    String?
  /// IANA zone; defaults to the organization timezone at creation.
  timezone       String
  preferredUnits Units        @default(kg) @map("preferred_units")
  consentVersion String?      @map("consent_version")
  consentAt      DateTime?    @map("consent_at") @db.Timestamptz(3)
  /// ISO weekday (1 = Monday ... 7 = Sunday) the weekly check-in is issued on; null = no check-ins (S4-1).
  checkinWeekday    Int?      @map("checkin_weekday")
  checkinTemplateId String?   @map("checkin_template_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization        @relation(fields: [organizationId], references: [id])
  user            User?               @relation("ClientUser", fields: [userId], references: [id])
  coach           User                @relation("ClientCoach", fields: [coachUserId], references: [id])
  invites         ClientInvite[]
  programs        Program[]
  assignments     ProgramAssignment[]
  workoutSessions WorkoutSession[]
  pauses          ClientPause[]
  /// Composite FK (MATCH SIMPLE: null until a weekday is set) keeps the template in this org.
  checkinTemplate CheckinTemplate?    @relation(fields: [checkinTemplateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  checkins        Checkin[]
  thread          ConversationThread?
  reviewFlags     ReviewFlag[]
  internalNotes   InternalNote[]
  exportJobs      ExportJob[]
  deletionRequests DeletionRequest[]
  supportGrants   SupportAccessGrant[]
  metricEntries   MetricEntry[]
  metricEntryRevisions MetricEntryRevision[]
  habits          Habit[]
  habitLogs       HabitLog[]
  tagLinks        ClientTagLink[]
  nutritionTargets NutritionTarget[]
  nutritionLogs   NutritionLog[]

  @@unique([organizationId, email])
  @@unique([organizationId, userId])
  /// Target of the composite (child_fk, organization_id) FKs that keep parent and child in one tenant (D-008).
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt, id])
  @@map("clients")
}

model ClientInvite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  /// sha256 hex of the token; the plaintext only ever lives in the outbox payload until sent.
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  creator      User         @relation(fields: [createdBy], references: [id])

  @@index([clientId])
  @@index([organizationId])
  @@map("client_invites")
}

/// Users-level (keyed by user, not tenant-owned): a coach's own profile, shared across their organizations.
/// Forced RLS: a row is visible only to its own user (app.user_id).
model CoachProfile {
  /// The user's id; one profile per user.
  userId      String   @id @map("user_id") @db.Uuid
  bio         String?
  specialties String[]
  units       Units    @default(kg)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coach_profiles")
}

/// Users-level (keyed by user, not tenant-owned): email opt-ins. Both default off.
/// Forced RLS: a row is visible only to its own user (app.user_id).
model NotificationPreference {
  /// The user's id; one row per user.
  userId            String   @id @map("user_id") @db.Uuid
  messageEmailOptIn Boolean  @default(false) @map("message_email_opt_in")
  marketingOptIn    Boolean  @default(false) @map("marketing_opt_in")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Exercise library. organizationId null = global catalog row (readable by every
/// organization, writable by none; see the exercises migration). Org rows are custom.
/// Case-insensitive name uniqueness per org is an expression index
/// (exercises_org_lower_name_key) that Prisma cannot model; it lives in the migration.
model Exercise {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  name           String
  equipment      String
  muscleGroup    String       @map("muscle_group")
  movementType   String       @map("movement_type")
  trackingType   TrackingType @map("tracking_type")
  /// Plain text, at most 2000 characters.
  instructions   String       @default("")
  /// https only, at most 500 characters.
  mediaUrl       String?      @map("media_url")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization            Organization?            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workoutVersionExercises WorkoutVersionExercise[]

  @@index([organizationId, name, id])
  @@index([organizationId, createdAt])
  @@map("exercises")
}

enum ProgramKind {
  template
  client

  @@map("program_kind")
}

enum ProgramStatus {
  active
  archived

  @@map("program_status")
}

/// A reusable template (kind=template) or one client's copy (kind=client). Its content lives in
/// immutable ProgramVersions; `currentVersionId` points at the latest committed one (null until the first commit).
/// The row doubles as the lock that serializes commits (D-001 optimistic concurrency).
model Program {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  /// At most 120 characters.
  title            String
  kind             ProgramKind   @default(template)
  clientId         String?       @map("client_id") @db.Uuid
  sourceProgramId  String?       @map("source_program_id") @db.Uuid
  sourceVersionId  String?       @map("source_version_id") @db.Uuid
  currentVersionId String?       @unique @map("current_version_id") @db.Uuid
  status           ProgramStatus @default(active)
  createdBy        String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization        @relation(fields: [organizationId], references: [id])
  /// Composite FK (MATCH SIMPLE: null for templates) keeps a copy in its client's org; RESTRICT, not SET NULL,
  /// since SET NULL would also null organization_id (migration 000016).
  client         Client?             @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  creator        User                @relation("ProgramCreator", fields: [createdBy], references: [id])
  /// Composite FKs (MATCH SIMPLE: null skips the check) keep the source and current version in this org (migration 000017).
  sourceProgram  Program?            @relation("ProgramSource", fields: [sourceProgramId, organizationId], references: [id, organizationId], onDelete: Restrict)
  copies         Program[]           @relation("ProgramSource")
  sourceVersion  ProgramVersion?     @relation("ProgramSourceVersion", fields: [sourceVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  currentVersion ProgramVersion?     @relation("ProgramCurrentVersion", fields: [currentVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  versions       ProgramVersion[]    @relation("ProgramVersions")
  assignments    ProgramAssignment[]
  draft          ProgramDraft?

  @@unique([id, organizationId])
  /// Lets the 1:1 currentVersion relation use the composite key; currentVersionId alone stays unique too.
  @@unique([currentVersionId, organizationId])
  @@index([organizationId, kind, status, createdAt, id])
  @@index([organizationId, clientId])
  @@map("programs")
}

/// One committed save of a program: a slot map from (weekIndex, dayIndex) to WorkoutVersion (D-002 #2). Immutable.
model ProgramVersion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  versionNo      Int      @map("version_no")
  committedBy    String   @map("committed_by") @db.Uuid
  committedAt    DateTime @default(now()) @map("committed_at") @db.Timestamptz(3)
  daysPerWeek    Int      @map("days_per_week")
  weekCount      Int      @map("week_count")

  organization   Organization  @relation(fields: [organizationId], references: [id])
  program        Program       @relation("ProgramVersions", fields: [programId, organizationId], references: [id, organizationId])
  committer      User          @relation("ProgramVersionCommitter", fields: [committedBy], references: [id])
  slots          ProgramSlot[]
  currentOf      Program?      @relation("ProgramCurrentVersion")
  sourceOfCopies Program[]     @relation("ProgramSourceVersion")

  @@unique([programId, versionNo])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("program_versions")
}

model ProgramSlot {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  programVersionId String @map("program_version_id") @db.Uuid
  /// Zero-based.
  weekIndex        Int    @map("week_index")
  /// Zero-based.
  dayIndex         Int    @map("day_index")
  workoutVersionId String @map("workout_version_id") @db.Uuid

  organization   Organization   @relation(fields: [organizationId], references: [id])
  programVersion ProgramVersion @relation(fields: [programVersionId, organizationId], references: [id, organizationId])
  workoutVersion WorkoutVersion @relation(fields: [workoutVersionId, organizationId], references: [id, organizationId])

  @@unique([programVersionId, weekIndex, dayIndex])
  @@index([organizationId])
  @@index([workoutVersionId])
  @@map("program_slots")
}

/// Immutable (D-002 #1): no update or delete code paths exist. Shared by every program version whose slot holds the same content.
model WorkoutVersion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// At most 120 characters.
  title          String
  notes          String   @default("")
  /// sha256 hex of the canonical JSON of {title, notes, exercises}.
  contentHash    String   @map("content_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization             @relation(fields: [organizationId], references: [id])
  exercises       WorkoutVersionExercise[]
  slots           ProgramSlot[]
  workoutSessions WorkoutSession[]

  @@unique([id, organizationId])
  @@index([organizationId, contentHash])
  @@map("workout_versions")
}

model WorkoutVersionExercise {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  workoutVersionId String  @map("workout_version_id") @db.Uuid
  exerciseId       String  @map("exercise_id") @db.Uuid
  /// Zero-based order within the workout.
  position         Int
  /// Zod-validated set targets (targetSchema).
  targetJson       Json    @map("target_json")
  note             String?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  workoutVersion WorkoutVersion @relation(fields: [workoutVersionId, organizationId], references: [id, organizationId])
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])
  setLogs        SetLog[]

  @@unique([workoutVersionId, position])
  /// Target of set_logs' composite tenant FK.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([exerciseId])
  @@map("workout_version_exercises")
}

enum AssignmentStatus {
  active
  ended
  completed

  @@map("assignment_status")
}

enum SessionState {
  scheduled
  in_progress
  completed
  skipped
  missed
  incomplete
  cancelled

  @@map("session_state")
}

/// A client's copy of a program running on chosen weekdays (D-001, D-010 #2). At most one `active` per client:
/// the partial unique index program_assignments_one_active_per_client lives in the migration (Prisma cannot model it).
model ProgramAssignment {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  clientId             String           @map("client_id") @db.Uuid
  /// The client's copy (kind=client), not the template.
  programId            String           @map("program_id") @db.Uuid
  startLocalDate       DateTime         @map("start_local_date") @db.Date
  /// ISO weekdays 1-7.
  weekdays             Int[]
  /// The client's IANA zone at assignment time.
  timezone             String
  status               AssignmentStatus @default(active)
  readinessConfirmedAt DateTime?        @map("readiness_confirmed_at") @db.Timestamptz(3)
  readinessConfirmedBy String?          @map("readiness_confirmed_by") @db.Uuid
  endedAt              DateTime?        @map("ended_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  client          Client           @relation(fields: [clientId, organizationId], references: [id, organizationId])
  program         Program          @relation(fields: [programId, organizationId], references: [id, organizationId])
  readinessBy     User?            @relation("AssignmentReadinessConfirmer", fields: [readinessConfirmedBy], references: [id])
  workoutSessions WorkoutSession[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([clientId])
  @@index([programId])
  @@map("program_assignments")
}

/// One planned workout (D-002 #4): generated at assign time for every slot. `workoutVersionId` stays null until locked.
model WorkoutSession {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  assignmentId       String       @map("assignment_id") @db.Uuid
  clientId           String       @map("client_id") @db.Uuid
  slotWeekIndex      Int          @map("slot_week_index")
  slotDayIndex       Int          @map("slot_day_index")
  /// Intended calendar date in the client's timezone.
  scheduledLocalDate DateTime     @map("scheduled_local_date") @db.Date
  /// 00:00 local on the date, as UTC.
  scheduledAt        DateTime     @map("scheduled_at") @db.Timestamptz(3)
  /// 23:59 local on the date, as UTC.
  dueAt              DateTime     @map("due_at") @db.Timestamptz(3)
  state              SessionState @default(scheduled)
  workoutVersionId   String?      @map("workout_version_id") @db.Uuid
  startedAt          DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(3)
  submittedAt        DateTime?    @map("submitted_at") @db.Timestamptz(3)
  comment            String?
  loggedByUserId     String?      @map("logged_by_user_id") @db.Uuid
  pauseOffsetDays    Int          @default(0) @map("pause_offset_days")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization      @relation(fields: [organizationId], references: [id])
  assignment     ProgramAssignment @relation(fields: [assignmentId, organizationId], references: [id, organizationId])
  client         Client            @relation(fields: [clientId, organizationId], references: [id, organizationId])
  /// Composite FK (MATCH SIMPLE: null until locked) keeps the locked version in this org (migration 000017).
  workoutVersion WorkoutVersion?   @relation(fields: [workoutVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  loggedBy       User?             @relation("SessionLogger", fields: [loggedByUserId], references: [id])
  setLogs        SetLog[]
  setLogRevisions SetLogRevision[]

  @@unique([assignmentId, slotWeekIndex, slotDayIndex])
  /// Target of set_logs' composite tenant FK.
  @@unique([id, organizationId])
  @@index([organizationId, clientId, dueAt])
  /// Portal "upcoming" reads and the S4 missed-session sweep.
  @@index([organizationId, state, dueAt])
  /// Review list "new completed workouts" (S2-4).
  @@index([organizationId, state, completedAt])
  @@index([assignmentId])
  @@index([workoutVersionId])
  @@map("workout_sessions")
}

/// One logged set (F08, D-004 #7, D-008 #8): upserted on (session, workout version exercise, set index), so replays
/// never double-enter. Weight is stored in kg. The newest client-recorded write wins (D-004 multi-device rule).
/// Range CHECKs live in the migration. Editing after submission (S3-4) adds audited SetLogRevisions.
model SetLog {
  id                       String   @id @default(uuid()) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  sessionId                String   @map("session_id") @db.Uuid
  workoutVersionExerciseId String   @map("workout_version_exercise_id") @db.Uuid
  /// Zero-based, 0-19.
  setIndex                 Int      @map("set_index")
  reps                     Int?
  weightKg                 Decimal? @map("weight_kg") @db.Decimal(7, 3)
  rpe                      Decimal? @db.Decimal(3, 1)
  durationSeconds          Int?     @map("duration_seconds")
  distanceM                Decimal? @map("distance_m") @db.Decimal(9, 3)
  /// When the device recorded this value; older writes than the stored one are ignored.
  clientUpdatedAt          DateTime @map("client_updated_at") @db.Timestamptz(3)
  clientMutationId         String   @map("client_mutation_id") @db.Uuid
  /// Who wrote the current value (the client, or a coach logging on their behalf).
  loggedByUserId           String   @map("logged_by_user_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization           Organization           @relation(fields: [organizationId], references: [id])
  session                WorkoutSession         @relation(fields: [sessionId, organizationId], references: [id, organizationId])
  workoutVersionExercise WorkoutVersionExercise @relation(fields: [workoutVersionExerciseId, organizationId], references: [id, organizationId])
  loggedBy               User                   @relation("SetLogWriter", fields: [loggedByUserId], references: [id])
  revisions              SetLogRevision[]

  @@unique([sessionId, workoutVersionExerciseId, setIndex])
  /// Target of set_log_revisions' composite tenant FK.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([workoutVersionExerciseId])
  @@map("set_logs")
}

enum SetLogRevisionRole {
  client
  coach

  @@map("set_log_revision_role")
}

/// One change to a set log after its session was submitted (S3-4, Ruling 5): a client's own edit within 24 hours or a
/// coach's correction (reason required, shown to coaches only). Append-only: the database rejects UPDATE, DELETE and
/// TRUNCATE (migration 000022). `before`/`after` are `{ reps, weightKg, rpe, durationSeconds, distanceM }` as numbers;
/// `beforeJson` is null when the edit created the set. Reason length (<= 500) is a CHECK in the migration.
model SetLogRevision {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  setLogId       String             @map("set_log_id") @db.Uuid
  sessionId      String             @map("session_id") @db.Uuid
  beforeJson     Json?              @map("before_json")
  afterJson      Json               @map("after_json")
  reason         String?
  revisedBy      String             @map("revised_by") @db.Uuid
  revisedByRole  SetLogRevisionRole @map("revised_by_role")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id])
  setLog       SetLog         @relation(fields: [setLogId, organizationId], references: [id, organizationId])
  session      WorkoutSession @relation(fields: [sessionId, organizationId], references: [id, organizationId])
  reviser      User           @relation("SetLogReviser", fields: [revisedBy], references: [id])

  @@index([sessionId, createdAt])
  @@index([organizationId])
  @@index([setLogId])
  @@map("set_log_revisions")
}

/// Unvalidated builder state, one per program (S3-1, Ruling 4: last write wins between tabs). `baseVersionNo` is the
/// version the editor was opened on (null = no commit yet); conflicts are detected only at commit.
model ProgramDraft {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  programId      String   @unique @map("program_id") @db.Uuid
  baseVersionNo  Int?     @map("base_version_no")
  /// `{ title?: string; weeks: unknown[] }`, at most 256 KiB serialized.
  draftJson      Json     @map("draft_json")
  updatedBy      String   @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  program      Program      @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: Cascade)
  editor       User         @relation("ProgramDraftEditor", fields: [updatedBy], references: [id])

  @@unique([programId, organizationId])
  @@index([organizationId])
  @@map("program_drafts")
}

/// A pause of a client's program (S3-5, D-003, Ruling 6). `appliedOffsetDays` is how far the client's scheduled
/// sessions from `startLocalDate` on have been moved for this pause, so every reschedule shifts only the difference
/// and nothing moves twice. At most one open pause (`endedAt` null) per client (partial unique index, migration).
model ClientPause {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  startLocalDate    DateTime  @map("start_local_date") @db.Date
  resumeLocalDate   DateTime  @map("resume_local_date") @db.Date
  appliedOffsetDays Int       @default(0) @map("applied_offset_days")
  endedAt           DateTime? @map("ended_at") @db.Timestamptz(3)
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  creator      User         @relation("ClientPauseCreator", fields: [createdBy], references: [id])

  @@index([clientId])
  @@index([organizationId])
  /// The worker's due-pause scan.
  @@index([endedAt, resumeLocalDate])
  @@map("client_pauses")
}

/// The organization's weekly check-in template (S4-1, D-008 #9, Ruling 1: one per organization), created from the
/// seeded questions on first use and editable by the coach. `questionsJson` is validated by core (`questionsSchema`).
model CheckinTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  title          String
  questionsJson  Json     @map("questions_json")
  isSeeded       Boolean  @default(true) @map("is_seeded")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  clients      Client[]
  checkins     Checkin[]

  @@unique([id, organizationId])
  @@map("checkin_templates")
}

/// One weekly check-in of a client (S4-1, D-010 #3): issued 06:00 local, due 23:59 local. `questionsJson` is the
/// template's questions when issued, so later template edits never change what was asked.
model Checkin {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  clientId             String    @map("client_id") @db.Uuid
  templateId           String    @map("template_id") @db.Uuid
  periodLocalDate      DateTime  @map("period_local_date") @db.Date
  questionsJson        Json      @map("questions_json")
  issuedAt             DateTime  @map("issued_at") @db.Timestamptz(3)
  dueAt                DateTime  @map("due_at") @db.Timestamptz(3)
  submittedAt          DateTime? @map("submitted_at") @db.Timestamptz(3)
  answersJson          Json?     @map("answers_json")
  draftJson            Json?     @map("draft_json")
  draftUpdatedAt       DateTime? @map("draft_updated_at") @db.Timestamptz(3)
  submitIdempotencyKey String?   @map("submit_idempotency_key")
  /// When a coach marked the submitted check-in reviewed (PRD F14); the client sees it.
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId     String?   @map("reviewed_by_user_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  client       Client          @relation(fields: [clientId, organizationId], references: [id, organizationId])
  template     CheckinTemplate @relation(fields: [templateId, organizationId], references: [id, organizationId])
  reviewedBy   User?           @relation("CheckinReviewer", fields: [reviewedByUserId], references: [id])

  @@unique([clientId, periodLocalDate])
  @@unique([id, organizationId])
  @@index([organizationId, dueAt])
  @@index([organizationId, submittedAt])
  @@index([templateId])
  @@map("checkins")
}

/// The one conversation of a client and their coach (S4-4, Ruling 6), created on first open.
model ConversationThread {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @unique @map("client_id") @db.Uuid
  coachUserId    String   @map("coach_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  coach        User         @relation("ThreadCoach", fields: [coachUserId], references: [id])
  messages     Message[]

  @@unique([id, organizationId])
  /// Implied by the unique client_id; required by Prisma for the one-to-one composite relation.
  @@unique([clientId, organizationId])
  @@index([organizationId])
  @@map("conversation_threads")
}

/// A text message (D-008 #1): immutable except `readAt` (trigger, migration 000025); DELETE only under lawful
/// erasure and never TRUNCATE (migration 000030). The body never reaches logs, analytics or audit.
/// `clientMessageId` makes a retried send idempotent.
model Message {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  threadId        String    @map("thread_id") @db.Uuid
  senderUserId    String    @map("sender_user_id") @db.Uuid
  body            String
  clientMessageId String?   @map("client_message_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id])
  thread       ConversationThread @relation(fields: [threadId, organizationId], references: [id, organizationId])
  sender       User               @relation("MessageSender", fields: [senderUserId], references: [id])

  @@unique([threadId, clientMessageId])
  @@index([threadId, createdAt, id])
  @@index([organizationId, readAt])
  @@map("messages")
}

enum ReviewRule {
  missed_workouts
  checkin_overdue
  checkin_new
  message_unread
  coach_followup

  @@map("review_rule")
}

enum ReviewFlagState {
  open
  snoozed
  resolved
  dismissed

  @@map("review_flag_state")
}

/// A "Needs review" item in the coach's queue (S4-2/S4-3, F10, D-008 #11). Raised by the rules engine (time-based,
/// `review.sweep`) or in the triggering transaction (check-in submitted, coach follow-up). `dedupeKey` makes each
/// raise idempotent; `evidenceJson` lists the rule text, dates and source ids (never free text).
model ReviewFlag {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  clientId         String          @map("client_id") @db.Uuid
  ruleKey          ReviewRule      @map("rule_key")
  /// Always "needs_review" in R1 ("Needs review", never "At risk").
  severity         String          @default("needs_review")
  sourceType       String          @map("source_type")
  sourceId         String?         @map("source_id") @db.Uuid
  dedupeKey        String          @map("dedupe_key")
  evidenceJson     Json            @map("evidence_json")
  /// When the source was due (session or check-in), for sorting and display; unchanged by a snooze.
  sourceDueAt      DateTime?       @map("source_due_at") @db.Timestamptz(3)
  state            ReviewFlagState @default(open)
  snoozedUntil     DateTime?       @map("snoozed_until") @db.Timestamptz(3)
  resolvedBy       String?         @map("resolved_by") @db.Uuid
  resolvedAt       DateTime?       @map("resolved_at") @db.Timestamptz(3)
  resolutionReason String?         @map("resolution_reason")
  reopenedAt       DateTime?       @map("reopened_at") @db.Timestamptz(3)
  /// The coach who created a follow-up (null for rule-raised flags).
  createdBy        String?         @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  resolver     User?        @relation("FlagResolver", fields: [resolvedBy], references: [id])
  creator      User?        @relation("FlagCreator", fields: [createdBy], references: [id])

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, state])
  @@index([clientId, ruleKey, state])
  @@map("review_flags")
}

/// A coach's private note about a client (S4-5, F12). Coach/owner only: never in a client API or portal payload.
/// Only the author edits or deletes it.
model InternalNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  body           String
  /// Pinned to the client context card (PRD B7); at most 3 per client, enforced in core.
  pinnedAt       DateTime? @map("pinned_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  author       User         @relation("NoteAuthor", fields: [authorUserId], references: [id])

  @@index([clientId, createdAt])
  @@index([organizationId])
  @@map("internal_notes")
}

enum BodyMetric {
  weight
  body_fat
  waist
  hips
  chest
  arm
  thigh
  resting_hr
  steps

  @@map("body_metric")
}

enum MetricSource {
  client
  coach

  @@map("metric_source")
}

/// One body metric value for a client on a client-local date (PRD E1): at most one per metric and day. Values are
/// canonical (kg, cm, %, bpm, steps) and shown in the viewer's units. A change to an existing value adds an
/// append-only MetricEntryRevision. The value range CHECK lives in the migration; per-metric ranges are in core.
model MetricEntry {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  clientId         String       @map("client_id") @db.Uuid
  metric           BodyMetric
  /// The client-local calendar date the value was measured on.
  measuredOn       DateTime     @map("measured_on") @db.Date
  value            Decimal      @db.Decimal(10, 3)
  /// Who recorded the current value.
  source           MetricSource
  recordedByUserId String       @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id])
  client       Client                @relation(fields: [clientId, organizationId], references: [id, organizationId])
  recordedBy   User                  @relation("MetricRecorder", fields: [recordedByUserId], references: [id])
  revisions    MetricEntryRevision[]

  @@unique([clientId, metric, measuredOn])
  /// Target of metric_entry_revisions' composite tenant FK.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("metric_entries")
}

/// One change to an existing metric value (PRD E1), append-only like set_log_revisions: the database rejects UPDATE,
/// DELETE and TRUNCATE except lawful erasure. A coach changing a value needs a reason, shown to coaches only.
model MetricEntryRevision {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  clientId        String       @map("client_id") @db.Uuid
  entryId         String       @map("entry_id") @db.Uuid
  beforeValue     Decimal      @map("before_value") @db.Decimal(10, 3)
  afterValue      Decimal      @map("after_value") @db.Decimal(10, 3)
  role            MetricSource
  reason          String?
  revisedByUserId String       @map("revised_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  entry        MetricEntry  @relation(fields: [entryId, organizationId], references: [id, organizationId])
  revisedBy    User         @relation("MetricReviser", fields: [revisedByUserId], references: [id])

  @@index([entryId, createdAt])
  @@index([organizationId])
  @@index([clientId])
  @@map("metric_entry_revisions")
}

enum HabitStatus {
  active
  archived

  @@map("habit_status")
}

/// A habit or one-off task a coach assigns to one client (PRD G1, G3). A habit repeats on `daysPerWeek` days (7 =
/// daily) from `startDate` until `endDate`; a task (`isTask`) is done once by `dueDate`. Ranges are CHECKs in the
/// migration.
model Habit {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  clientId        String      @map("client_id") @db.Uuid
  title           String
  isTask          Boolean     @default(false) @map("is_task")
  /// Habits only: how many days a week (1-7).
  daysPerWeek     Int?        @map("days_per_week")
  /// Optional amount per day ("8" glasses); null = a simple done/not done.
  targetCount     Int?        @map("target_count")
  unit            String?
  startDate       DateTime    @map("start_date") @db.Date
  endDate         DateTime?   @map("end_date") @db.Date
  /// Tasks only.
  dueDate         DateTime?   @map("due_date") @db.Date
  status          HabitStatus @default(active)
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  createdBy    User         @relation("HabitCreator", fields: [createdByUserId], references: [id])
  logs         HabitLog[]

  /// Target of habit_logs' composite tenant FK.
  @@unique([id, organizationId])
  @@index([clientId, status])
  @@index([organizationId])
  @@map("habits")
}

/// One day's tick on a habit (or the completion of a task), on the client-local date (PRD G1): unique per habit and
/// day, so a double tap never counts twice. Unticking deletes the row.
model HabitLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  habitId        String   @map("habit_id") @db.Uuid
  localDate      DateTime @map("local_date") @db.Date
  /// 1 for a simple tick; the amount for a habit with a target.
  value          Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  habit        Habit        @relation(fields: [habitId, organizationId], references: [id, organizationId])

  @@unique([habitId, localDate])
  @@index([clientId, localDate])
  @@index([organizationId])
  @@map("habit_logs")
}

enum TagColor {
  teal
  blue
  purple
  orange
  red
  gray

  @@map("tag_color")
}

/// A workspace tag for grouping clients (PRD B4), e.g. "Online" or "Fat loss". Names are unique per organization,
/// case-insensitively (index in the migration).
model ClientTag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  color          TagColor @default(teal)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  links        ClientTagLink[]

  /// Target of client_tag_links' composite tenant FK.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("client_tags")
}

/// A tag on a client (PRD B4). Removing the tag or the client's tag removes the link.
model ClientTagLink {
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  tag          ClientTag    @relation(fields: [tagId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
  @@index([organizationId])
  @@map("client_tag_links")
}

/// Daily nutrition targets a coach sets for a client from a client-local date on (PRD G6). The newest target whose
/// `effectiveFrom` is on or before a day applies to that day; earlier ones stay as history. Ranges are CHECKs.
model NutritionTarget {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  effectiveFrom   DateTime @map("effective_from") @db.Date
  calories        Int?
  proteinG        Int?     @map("protein_g")
  carbsG          Int?     @map("carbs_g")
  fatG            Int?     @map("fat_g")
  setByUserId     String   @map("set_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  setBy        User         @relation("NutritionTargetSetter", fields: [setByUserId], references: [id])

  @@unique([clientId, effectiveFrom])
  @@index([organizationId])
  @@map("nutrition_targets")
}

/// One day's nutrition totals for a client, on the client-local date (PRD G7): at most one per day; saving again
/// replaces it. Each value is optional (log what you track).
model NutritionLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  localDate      DateTime @map("local_date") @db.Date
  calories       Int?
  proteinG       Int?     @map("protein_g")
  carbsG         Int?     @map("carbs_g")
  fatG           Int?     @map("fat_g")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])

  @@unique([clientId, localDate])
  @@index([organizationId])
  @@map("nutrition_logs")
}

enum ExportScope {
  client_self
  org

  @@map("export_scope")
}

enum ExportStatus {
  queued
  running
  done
  failed

  @@map("export_status")
}

/// A data export (S5-2, D-010 #4): requested in the app, built by the worker (`exports.build`) as CSV objects in
/// private storage, downloadable only by the requester through short-lived app links. `filesJson` is written last,
/// so a failed or half-built export never offers a file.
model ExportJob {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  requestedBy    String       @map("requested_by") @db.Uuid
  /// The client's own export (`client_self`); null for an organization export.
  clientId       String?      @map("client_id") @db.Uuid
  scope          ExportScope
  resourceType   String       @default("csv_bundle") @map("resource_type")
  status         ExportStatus @default(queued)
  /// Storage prefix of the job's files.
  objectKey      String?      @map("object_key")
  /// `[{ name, key, rows }]`, set when the job is done.
  filesJson      Json?        @map("files_json")
  attempts       Int          @default(0)
  claimedAt      DateTime?    @map("claimed_at") @db.Timestamptz(3)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
  /// Downloads are offered until then.
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(3)
  /// A short error code (never content) when failed.
  errorCode      String?      @map("error_code")
  /// When the files were removed from storage (after expiry, or after an erasure expired the export).
  purgedAt       DateTime?    @map("purged_at") @db.Timestamptz(3)
  idempotencyKey String       @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  requester    User         @relation("ExportRequester", fields: [requestedBy], references: [id])
  /// Composite FK (MATCH SIMPLE: null for org exports) keeps the client in this org.
  client       Client?      @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, requestedBy, idempotencyKey])
  @@index([status, createdAt])
  @@index([organizationId, requestedBy, createdAt])
  @@index([expiresAt])
  @@map("export_jobs")
}

enum DeletionStatus {
  requested
  verified
  processing
  done
  rejected

  @@map("deletion_status")
}

/// A request to erase a client's data in one organization (S5-3, D-008 #16, D-010 #4): by the client or the
/// organization's owner, verified by a platform admin, then run by the worker (`deletions.run`). `legalHold` blocks
/// the run. One open request per client (partial unique index, migration). A tenant transaction may only read rows
/// and file one in its initial `requested` state; every other write is system scope (RLS, migration 000030).
model DeletionRequest {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  subjectClientId String         @map("subject_client_id") @db.Uuid
  /// The client's account at request time (kept for the admin; the account is anonymized, not deleted).
  subjectUserId   String?        @map("subject_user_id") @db.Uuid
  requestedBy     String         @map("requested_by") @db.Uuid
  status          DeletionStatus @default(requested)
  legalHold       Boolean        @default(false) @map("legal_hold")
  verifiedBy      String?        @map("verified_by") @db.Uuid
  verifiedAt      DateTime?      @map("verified_at") @db.Timestamptz(3)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(3)
  rejectedReason  String?        @map("rejected_reason")
  /// Failed erasure runs; a request that failed runs after untried ones.
  attempts        Int            @default(0)
  /// A short error code (never content) from the last failed run.
  lastErrorCode   String?        @map("last_error_code")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [subjectClientId, organizationId], references: [id, organizationId])
  subject      User?        @relation("DeletionSubject", fields: [subjectUserId], references: [id])
  requester    User         @relation("DeletionRequester", fields: [requestedBy], references: [id])
  verifier     User?        @relation("DeletionVerifier", fields: [verifiedBy], references: [id])

  @@index([status, createdAt])
  @@index([organizationId])
  @@index([subjectClientId, createdAt])
  @@map("deletion_requests")
}

/// Explicit, audited platform-admin access to one client's data (S5-3, D-006 roles, D-008 #19): a reason and a
/// 24-hour expiry. Without an unexpired, unrevoked grant an admin can't read client data. The organization may read
/// its grants; only system scope writes them (RLS, migration 000030).
model SupportAccessGrant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  adminUserId    String    @map("admin_user_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  reason         String
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  admin        User         @relation("SupportAdmin", fields: [adminUserId], references: [id])
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([adminUserId, clientId, expiresAt])
  @@index([organizationId])
  @@map("support_access_grants")
}
