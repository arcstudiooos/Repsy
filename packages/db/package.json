{
  "name": "@kinetic/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.16",
    "embedded-postgres": "17.9.0-beta.17",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pilot-code:create": "node --env-file-if-exists=../../.env --import tsx scripts/pilot-code-create.ts",
    "db:diff": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "exercises:sql": "node --import tsx scripts/exercise-catalog-sql.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts",
    "db:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:wait-migrations": "node --env-file-if-exists=../../.env --import tsx scripts/wait-for-migrations.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/createTestDb.ts",
    "./testing/app-role": "./src/testing/appRole.ts"
  }
}
