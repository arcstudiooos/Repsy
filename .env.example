# Copy to .env at the repo root (`cp .env.example .env`). Never commit real secrets.
# `pnpm dev`, `pnpm db:migrate`, `pnpm db:seed`, pilot-code:create and pgboss:migrate load this file
# (Node --env-file-if-exists; real environment variables win). `pnpm test` does not read it.
# With every provider key below left blank the app runs fully locally: emails go to the dev sink
# (.dev-emails/, or DEV_EMAIL_DIR), Google sign-in is hidden, Sentry and PostHog are off.

# Local dev DB (`pnpm db:up`). Locally this Docker superuser is also the owner.
DATABASE_URL=postgresql://kinetic:kinetic@localhost:54320/kinetic
# Owner connection for `prisma migrate deploy`, `pnpm --filter @kinetic/worker pgboss:migrate`, db:seed and
# pilot-code:create. Leave blank locally (DATABASE_URL is used). Hosted: DATABASE_URL is the restricted
# `kinetic_app` role and this is the owner (docs/runbook.md); never set it in a runtime environment.
MIGRATION_DATABASE_URL=
# Scratch database for `pnpm --filter @kinetic/db db:diff` (migrate-diff check) and `migrate dev`. Contents are wiped.
SHADOW_DATABASE_URL=postgresql://kinetic:kinetic@localhost:54320/kinetic_shadow
# Set to true to refuse a superuser/BYPASSRLS/owner DB role locally (always enforced when NODE_ENV=production).
ENFORCE_RUNTIME_ROLE=
# Required by `pnpm db:seed` (>= 12 chars). Local only; never commit a real value.
SEED_PASSWORD=
# Dev-only placeholder. Production refuses it: generate one with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=replace-with-random-32-char-secret
# Optional: dedicated HMAC key for the kinetic_org cookie. Falls back to BETTER_AUTH_SECRET.
ORG_COOKIE_SECRET=
# Proxy hops that append to X-Forwarded-For (Render = 1). Client IP is taken that many entries from the end.
TRUSTED_PROXY_HOPS=1
BETTER_AUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Bare domains that only serve the landing page; every other path redirects to APP_BASE_URL.
# Production: MARKETING_HOSTS=repsy.fit,www.repsy.fit
MARKETING_HOSTS=

# Providers: all optional locally. Blank = off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PRD K10: Google Calendar sync uses the same Google client. Add the redirect URI
# <APP_BASE_URL>/api/v1/calendar/google/callback and enable the Google Calendar API.
# Optional key for encrypting calendar refresh tokens (defaults to one derived from BETTER_AUTH_SECRET).
CALENDAR_TOKEN_KEY=
# PRD I15: the AI assistant (Claude). Blank = the assistant shows "not set up".
ANTHROPIC_API_KEY=
# Blank = dev sink. Production requires both RESEND_API_KEY and EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=Kinetic <no-reply@example.test>
# PRD M13: where in-app support requests are emailed.
SUPPORT_EMAIL=support@example.test
# PRD H11 web push (VAPID, base64url): blank = off. Generate once with `npx web-push generate-vapid-keys`; the worker
# and the web app both need them. Pushes carry no content.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Product analytics (S5-4): blank = off. Events carry hashed ids and allowlisted properties only.
POSTHOG_KEY=
# PostHog ingestion host (default https://eu.i.posthog.com).
POSTHOG_HOST=
# HMAC key for ids sent to analytics. Required in production when POSTHOG_KEY is set.
ANALYTICS_HASH_SECRET=
# Private bucket for exports (S5-2). Blank S3_BUCKET = files under DEV_EXPORT_DIR (refused in production).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# Local export files (blank = <repo>/.dev-exports). Read by the worker (writes) and the web app (downloads).
DEV_EXPORT_DIR=
# HMAC key for 15-minute download links. Falls back to BETTER_AUTH_SECRET.
EXPORT_LINK_SECRET=

# Dev email sink directory (blank = <repo>/.dev-emails). Read by the worker and /api/dev/emails.
DEV_EMAIL_DIR=
WORKER_PORT=8081
# Outbox sweep interval (code default 30000). Short locally so verify emails arrive quickly.
OUTBOX_POLL_INTERVAL_MS=5000
# Test/E2E only. Leave unset everywhere else: the breached-password check must stay on.
DISABLE_BREACHED_PASSWORD_CHECK=

# Feature switches for built-but-on-hold work. Off unless exactly "true".
# Coach custom domains + branded sending (PRD L4). On hold, see docs/decisions.md D-015.
FEATURE_CUSTOM_DOMAINS=

# Interactive-transaction limits in ms (blank = Prisma defaults: 2000 wait, 5000 run). Raise on a small host.
DB_TX_MAX_WAIT_MS=
DB_TX_TIMEOUT_MS=
