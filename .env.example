# Placeholder values only. Copy to .env and fill in locally. Never commit real secrets.
# Local dev DB (`pnpm db:up`). Leaving DATABASE_URL unset makes tests fall back to embedded Postgres.
DATABASE_URL=postgresql://kinetic:kinetic@localhost:54320/kinetic
BETTER_AUTH_SECRET=replace-with-random-32-char-secret
# Optional: dedicated HMAC key for the kinetic_org cookie. Falls back to BETTER_AUTH_SECRET.
ORG_COOKIE_SECRET=
# Proxy hops that append to X-Forwarded-For (Render = 1). Client IP is taken that many entries from the end.
TRUSTED_PROXY_HOPS=1
BETTER_AUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Kinetic <no-reply@example.test>
SENTRY_DSN=
POSTHOG_KEY=
ANALYTICS_HASH_SECRET=replace-with-random-secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kinetic-dev
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
DEV_EMAIL_DIR=
WORKER_PORT=8081
NEXT_PUBLIC_SENTRY_DSN=
OUTBOX_POLL_INTERVAL_MS=30000
# Test/E2E only. Leave unset everywhere else: the breached-password check must stay on.
DISABLE_BREACHED_PASSWORD_CHECK=
